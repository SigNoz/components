{
	"name": "design-system",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"publint": "turbo run publint",
		"dev": "turbo run dev",
		"type-check": "turbo run type-check",
		"lint": "oxlint && pnpm -F @signozhq/ui react-compiler:strict-check && pnpm -F @signozhq/ui tokens:check",
		"lint:fix": "oxlint --fix",
		"clean": "turbo run clean && rm -rf node_modules",
		"fmt": "oxfmt --check",
		"fmt:fix": "oxfmt",
		"build-storybook": "turbo run build-storybook -- --output-dir=storybook-static",
		"chromatic": "pnpm install && pnpm build --filter=docs^... && turbo run chromatic --",
		"release": "turbo run build --filter=@signozhq/ui --filter=@signozhq/tailwind-config",
		"prepare": "husky",
		"test": "turbo run test",
		"pre-commit": "lint-staged"
	},
	"dependencies": {
		"@signozhq/design-tokens": "2.3.0",
		"@signozhq/icons": "0.4.0",
		"@tanstack/react-virtual": "^3.14.8"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "19.8.1",
		"@repo/typescript-config": "workspace:*",
		"@turbo/gen": "2.11.5",
		"@types/fs-extra": "11.0.4",
		"@types/node": "25.9.8",
		"@types/react-dom": "18.3.7",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitejs/plugin-react": "6.1.1",
		"baseline-browser-mapping": "2.11.26",
		"fs-extra": "11.4.1",
		"glob": "13.0.6",
		"husky": "9.1.7",
		"inquirer": "11.1.0",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"publint": "0.3.24",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"sass": "1.105.0",
		"turbo": "2.11.5",
		"typescript": "5.9.3",
		"vite": "8.3.1",
		"vite-plugin-css-injected-by-js": "4.0.1"
	},
	"resolutions": {
		"cross-spawn": "7.0.5",
		"esbuild": "0.25.0",
		"semver": ">=7.5.2",
		"tmp": "0.2.4"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "10.30.3"
		}
	},
	"engines": {
		"pnpm": ">=10.30.3 <11"
	},
	"pnpm": {
		"overrides": {
			"@types/node": "25.6.2",
			"sass": "1.78.0",
			"ajv@<6.14.0": "^6.14.2",
			"tmp@<0.2.6": ">=0.2.6",
			"js-yaml": ">=4.3.1",
			"nanoid": ">=3.3.18",
			"@babel/core": ">=7.29.6",
			"postcss@<=8.5.22": ">=8.5.23",
			"browserslist@<=4.28.6": ">=4.28.7",
			"undici@>=8.0.0 <8.9.0": ">=8.9.0",
			"fast-uri@>=4.0.0 <4.1.3": ">=4.1.3",
			"brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
			"@vitest/browser@>=4.0.0 <4.1.10": ">=4.1.10"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"unrs-resolver"
		]
	}
}
