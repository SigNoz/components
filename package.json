{
	"name": "design-system",
	"version": "0.0.23",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"publint": "turbo run publint",
		"dev": "turbo run dev",
		"type-check": "tsgo --noEmit -p tsconfig.json",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"clean": "turbo run clean && rm -rf node_modules",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"build-storybook": "turbo run build-storybook -- --output-dir=storybook-static",
		"chromatic": "pnpm install && pnpm build --filter=docs^... && turbo run chromatic --",
		"release": "turbo run build --filter=@signozhq/ui --filter=@signozhq/tailwind-config",
		"prepare": "husky",
		"pre-commit": "lint-staged"
	},
	"dependencies": {
		"@signozhq/design-tokens": "2.1.6",
		"@signozhq/icons": "0.4.0",
		"@tanstack/react-virtual": "^3.14.8"
	},
	"devDependencies": {
		"@commitlint/cli": "21.1.0",
		"@commitlint/config-conventional": "19.8.1",
		"@repo/typescript-config": "workspace:*",
		"@turbo/gen": "2.9.18",
		"@types/fs-extra": "11.0.4",
		"@types/node": "25.9.4",
		"@types/react-dom": "18.3.7",
		"@typescript/native-preview": "7.0.0-dev.20260622.1",
		"@vitejs/plugin-react": "5.2.0",
		"baseline-browser-mapping": "2.10.38",
		"fs-extra": "11.3.5",
		"glob": "13.0.6",
		"husky": "9.1.7",
		"inquirer": "11.1.0",
		"lint-staged": "^17.0.8",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.72.0",
		"publint": "0.3.21",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"sass": "1.101.0",
		"tsdown": "0.22.3",
		"turbo": "2.9.18",
		"typescript": "5.9.3",
		"vite": "npm:rolldown-vite@7.3.1",
		"vite-plugin-css-injected-by-js": "4.0.1"
	},
	"resolutions": {
		"cross-spawn": "7.0.5",
		"esbuild": "0.25.0",
		"semver": ">=7.5.2",
		"tmp": "0.2.4"
	},
	"packageManager": "pnpm@10.30.3",
	"pnpm": {
		"overrides": {
			"vite": "npm:rolldown-vite@7.3.1",
			"@types/node": "25.6.2",
			"sass": "1.78.0",
			"ajv@<6.14.0": "^6.14.2",
			"tmp@<0.2.6": ">=0.2.6",
			"js-yaml": ">=4.2.0",
			"@babel/core": ">=7.29.6",
			"postcss@<=8.5.22": ">=8.5.23",
			"undici@>=8.0.0 <8.9.0": ">=8.9.0",
			"fast-uri@>=3.0.0 <3.1.5": ">=3.1.5",
			"brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
			"@vitest/browser@>=4.0.0 <4.1.10": ">=4.1.10"
		},
		"packageExtensions": {
			"vite-plugin-lib-inject-css": {
				"peerDependencies": {
					"vite": "npm:rolldown-vite@7.3.1"
				}
			},
			"@vitejs/plugin-react": {
