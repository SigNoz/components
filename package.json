			},
			"@storybook/addon-vitest": {
				"peerDependencies": {
					"vite": "npm:rolldown-vite@7.3.1"
				}
			},
			"@vitest/mocker": {
				"peerDependencies": {
					"vite": "npm:rolldown-vite@7.3.1"
				}
			},
			"@storybook/csf-plugin": {
				"peerDependencies": {
					"vite": "npm:rolldown-vite@7.3.1"
				}
			}
		},
		"patchedDependencies": {
			"rolldown-vite@7.3.1": "patches/rolldown-vite@7.3.1.patch"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"unrs-resolver"
		]
	}
}
