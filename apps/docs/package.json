		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/react-window": "^1.8.8",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"playwright": "^1.61.0",
		"react-syntax-highlighter": "^16.1.1",
		"remark-gfm": "^4.0.1",
		"serve": "^14.2.1",
		"storybook": "^10.4.6",
		"vite": "8.2.1",
		"vitest": "^4.1.10"
	}
