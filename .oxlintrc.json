{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"jsPlugins": ["./plugins/signoz.mjs"],
	"plugins": ["react", "typescript", "unicorn", "oxc", "import", "jsx-a11y"],
	"env": {
		"browser": true,
		"node": true,
		"es2024": true
	},
	"rules": {
		"no-unused-vars": [
			"error",
			{
				"args": "after-used",
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"ignoreRestSiblings": true,
				"destructuredArrayIgnorePattern": "^_"
			}
		],
		"typescript/no-unused-vars": [
			"error",
			{
				"args": "after-used",
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"ignoreRestSiblings": true
			}
		],
		"typescript/consistent-type-imports": "error",
		"typescript/no-non-null-assertion": "warn",
		"typescript/no-explicit-any": "off",
		"no-shadow-restricted-names": "off",
		"react-hooks/rules-of-hooks": "error",
		"react-hooks/exhaustive-deps": "warn",
		"react/error-boundaries": "error",
		"react/globals": "error",
		"react/immutability": "error",
		"react/preserve-manual-memoization": "error",
		"react/purity": "error",
		"react/set-state-in-render": "error",
		"react/static-components": "error",
		"react/use-memo": "error",
		"react/void-use-memo": "error",
		"react/incompatible-library": "warn",
		"react/refs": "warn",
		"react/set-state-in-effect": "warn",
		"react/no-deriving-state-in-effects": "warn",
		"react/capitalized-calls": "warn",
		"react/hooks": "warn",
		"react/memo-dependencies": "warn",
		"react/invariant": "warn",
		"react/syntax": "warn",
		"react/unsupported-syntax": "warn",
		"react/no-array-index-key": "warn",
		"react/button-has-type": "warn",
		"import/no-default-export": "off",
		"jsx-a11y/click-events-have-key-events": "warn",
		"jsx-a11y/no-static-element-interactions": "warn",
		"jsx-a11y/anchor-is-valid": "warn",
		"jsx-a11y/role-supports-aria-props": "warn",
		"jsx-a11y/label-has-associated-control": "off",
		"jsx-a11y/prefer-tag-over-role": "warn",
		"jsx-a11y/role-has-required-aria-props": "warn",
		"jsx-a11y/no-autofocus": "warn",
		"signoz/no-conditional-text-nodes-with-siblings": "off",
		"signoz/no-return-text-nodes": "off"
	},
	"overrides": [
		{
			"files": ["**/*.stories.tsx", "**/*.stories.ts"],
			"rules": {
				"react-hooks/rules-of-hooks": "off"
			}
		},
		{
			"files": ["packages/ui/src/**/*.tsx", "packages/ui/src/**/*.ts"],
			"rules": {
				"signoz/no-conditional-text-nodes-with-siblings": "error",
				"signoz/no-return-text-nodes": "error"
			}
		}
	]
}
