{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"jsPlugins": ["./plugins/signoz.mjs"],
	"plugins": ["react", "typescript", "unicorn", "oxc", "import", "jsx-a11y"],
	"categories": {
		"correctness": "error"
	},
	"options": {
		"reportUnusedDisableDirectives": "error"
	},
	"env": {
		"browser": true,
		"node": true,
		"es2024": true
	},
	"rules": {
		"no-unused-vars": [
			"error",
			{
				"args": "after-used",
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"ignoreRestSiblings": true,
				"destructuredArrayIgnorePattern": "^_"
			}
		],
		"typescript/no-unused-vars": [
			"error",
			{
				"args": "after-used",
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"ignoreRestSiblings": true
			}
		],
		"typescript/consistent-type-imports": "error",
		"typescript/no-non-null-assertion": "error",
		"typescript/no-explicit-any": "off",
		"no-shadow-restricted-names": "off",
		"react-hooks/rules-of-hooks": "error",
		"react-hooks/exhaustive-deps": "error",
		"react/error-boundaries": "error",
		"react/globals": "error",
		"react/immutability": "error",
		"react/preserve-manual-memoization": "error",
		"react/purity": "error",
		"react/set-state-in-render": "error",
		"react/static-components": "error",
		"react/use-memo": "error",
		"react/void-use-memo": "error",
		"react/incompatible-library": "error",
		"react/refs": "error",
		"react/set-state-in-effect": "error",
		"react/no-deriving-state-in-effects": "error",
		"react/capitalized-calls": "error",
		"react/hooks": "error",
		"react/memo-dependencies": "error",
		"react/invariant": "error",
		"react/syntax": "error",
		"react/unsupported-syntax": "error",
		"react/no-array-index-key": "error",
		"react/button-has-type": "error",
		"import/no-default-export": "off",
		"jsx-a11y/click-events-have-key-events": "error",
		"jsx-a11y/no-static-element-interactions": "error",
		"jsx-a11y/anchor-is-valid": "error",
		"jsx-a11y/role-supports-aria-props": "error",
		"jsx-a11y/label-has-associated-control": "off",
		"jsx-a11y/prefer-tag-over-role": "error",
		"jsx-a11y/role-has-required-aria-props": "error",
		"jsx-a11y/no-autofocus": "error",
		"signoz/no-conditional-text-nodes-with-siblings": "off",
		"signoz/no-return-text-nodes": "off"
	},
	"overrides": [
		{
			"files": ["**/*.stories.tsx", "**/*.stories.ts"],
			"rules": {
				"react-hooks/rules-of-hooks": "off"
			}
		},
		{
			"files": ["packages/ui/src/**/*.tsx", "packages/ui/src/**/*.ts"],
			"rules": {
				"signoz/no-conditional-text-nodes-with-siblings": "error",
				"signoz/no-return-text-nodes": "error"
			}
		},
		{
			"files": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx", "**/*.test-d.tsx"],
			"rules": {
				"jsx-a11y/anchor-has-content": "off",
				"jsx-a11y/control-has-associated-label": "off",
				"jsx-a11y/no-autofocus": "off",
				"jsx-a11y/prefer-tag-over-role": "off"
			}
		},
		{
			"files": ["**/*.test-d.tsx"],
			"rules": {
				"react/no-children-prop": "off"
			}
		}
	]
}
